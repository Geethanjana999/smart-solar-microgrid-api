{
  "MongoDb": {
    "ConnectionString": "mongodb+srv://<username>:<password>@<cluster>/<database>",
    "DatabaseName": "SmartMicrogrid"
  },
  "Jwt": {
    "Key": "replace-with-a-long-random-secret",
    "Issuer": "SmartSolarMicrogrid",
    "Audience": "SmartSolarClients",
    "ExpiryMinutes": 480
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
